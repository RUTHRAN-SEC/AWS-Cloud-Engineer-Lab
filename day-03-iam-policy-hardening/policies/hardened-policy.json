{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowApplicationBucketListing",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::cloud-engineer-lab-day02-123321"
        },
        {
            "Sid": "AllowApplicationObjectAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::cloud-engineer-lab-day02-123321/*"
        },
        {
            "Sid": "AllowListAllBuckets",
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
        }
    ]
}
