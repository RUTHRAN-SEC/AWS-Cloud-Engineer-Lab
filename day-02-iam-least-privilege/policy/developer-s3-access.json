{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowBucketListing",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket"
			],
			"Resource": "arn:aws:s3:::BUCKET-NAME"
		},
		{
			"Sid": "AllowObjectReadWrite",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject"
			],
			"Resource": "arn:aws:s3:::BUCKET-NAME/*"
		},
		{
			"Sid": "AllowListAllBuckets",
			"Effect": "Allow",
			"Action": "s3:ListAllMyBuckets",
			"Resource": "*"
		}
	]
}
